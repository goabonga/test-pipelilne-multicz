# Copy this file to `.env` and edit. `.env` is gitignored.
#
# All values are optional; the compose stack falls back to sensible
# defaults when an entry is absent, so you can keep `.env` minimal.

# Host UID / GID used by the compose `user:` field on every service.
# Match `id -u` and `id -g` on Linux so bind mounts don't end up
# root-owned. On macOS / Windows the Docker Desktop file-sharing
# layer handles ownership for you; the defaults below work as-is.
USER_UID=1000
USER_GID=1000

# Port mappings for the HTTP services. Override if you have something
# else listening on these.
API_PORT=8000
SSR_PORT=8080

# Add application-level env here as you grow the surface — JWT signing
# keys, OIDC client secrets, future DB URLs, etc. Every service reads
# the .env via the `env_file:` directive in compose.yaml, so a single
# variable line is enough — no need to re-list per service.
