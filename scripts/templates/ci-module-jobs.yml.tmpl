
  infra-modules-@NAME@-fmt:
    needs: [detect, headers]
    if: contains(fromJson(needs.detect.outputs.changed).changed, 'infra-modules-@NAME@')
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - uses: ./.github/actions/infra-module-check
        with: { module: @NAME@, check: fmt }

  infra-modules-@NAME@-test:
    needs: [infra-modules-@NAME@-fmt]
    if: '!failure() && !cancelled() && needs.infra-modules-@NAME@-fmt.result == ''success'''
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - uses: ./.github/actions/infra-module-check
        with: { module: @NAME@, check: test }

  infra-modules-@NAME@-checkov:
    needs: [infra-modules-@NAME@-fmt]
    if: '!failure() && !cancelled() && needs.infra-modules-@NAME@-fmt.result == ''success'''
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - uses: ./.github/actions/infra-module-check
        with: { module: @NAME@, check: checkov }

  infra-modules-@NAME@-docs:
    needs: [infra-modules-@NAME@-fmt]
    if: '!failure() && !cancelled() && needs.infra-modules-@NAME@-fmt.result == ''success'''
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - uses: ./.github/actions/infra-module-check
        with: { module: @NAME@, check: docs }

  release-infra-modules-@NAME@:
    needs: [release-bump]
    if: >-
      !failure() && !cancelled() &&
      fromJson(needs.release-bump.outputs.bumps)['infra-modules-@NAME@'].next_version != ''
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - uses: ./.github/actions/publish-release
        with:
          tag: infra-modules-@NAME@-v${{ fromJson(needs.release-bump.outputs.bumps)['infra-modules-@NAME@'].next_version }}
          token: ${{ secrets.RELEASE_PAT || secrets.GITHUB_TOKEN }}
