
  infra-modules-@NAME@-fmt:
    needs: [detect, headers]
    if: contains(fromJson(needs.detect.outputs.changed).changed, 'infra-modules-@NAME@')
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - uses: hashicorp/setup-terraform@dfe3c3f87815947d99a8997f908cb6525fc44e9e  # v4
        with:
          terraform_wrapper: false
      - run: make infra-fmt-check M=@NAME@
      - name: Summary
        if: always()
        uses: ./.github/actions/summary
        with:
          title: infra-modules-@NAME@-fmt
          body: '`terraform fmt -check` on `infrastructure/modules/@NAME@`.'

  infra-modules-@NAME@-test:
    needs: [infra-modules-@NAME@-fmt]
    if: '!failure() && !cancelled() && needs.infra-modules-@NAME@-fmt.result == ''success'''
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - uses: hashicorp/setup-terraform@dfe3c3f87815947d99a8997f908cb6525fc44e9e  # v4
        with:
          terraform_wrapper: false
      - uses: ./.github/actions/bump-preview
      - run: make infra-test M=@NAME@
      - name: Summary
        if: always()
        uses: ./.github/actions/summary
        with:
          title: infra-modules-@NAME@-test
          body: '`terraform test` (offline, mock_provider) on `infrastructure/modules/@NAME@`.'

  infra-modules-@NAME@-checkov:
    needs: [infra-modules-@NAME@-fmt]
    if: '!failure() && !cancelled() && needs.infra-modules-@NAME@-fmt.result == ''success'''
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: bridgecrewio/checkov-action@7b972723c44fb3d256283fac96fae5d7c1894bb7  # v12
        with:
          directory: infrastructure/modules/@NAME@
          framework: terraform
          quiet: true
          output_format: cli
          soft_fail: false
      - name: Summary
        if: always()
        uses: ./.github/actions/summary
        with:
          title: infra-modules-@NAME@-checkov
          body: 'checkov on `infrastructure/modules/@NAME@`.'

  infra-modules-@NAME@-docs:
    needs: [infra-modules-@NAME@-fmt]
    if: '!failure() && !cancelled() && needs.infra-modules-@NAME@-fmt.result == ''success'''
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - uses: ./.github/actions/bump-preview
      - uses: ./.github/actions/setup-terraform-docs
      - run: make infra-docs-check M=@NAME@
      - name: Summary
        if: always()
        uses: ./.github/actions/summary
        with:
          title: infra-modules-@NAME@-docs
          body: '`terraform-docs --output-check` on `infrastructure/modules/@NAME@/README.md`.'
