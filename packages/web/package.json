{
  "name": "shomer-web",
  "version": "1.1.1",
  "description": "Source for shomer-ssr's TS / CSS / Jinja templates. Built outputs land in packages/ssr/src/shomer_ssr/{static,templates}/.",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome lint src tests",
    "format": "biome format --write src tests",
    "format:check": "biome format src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^25.9.3",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
