{
  "name": "shomer-web",
  "version": "1.0.1",
  "description": "Source for shomer-ssr's React islands / CSS / Jinja templates. Built outputs land in packages/ssr/src/shomer_ssr/{static,templates}/.",
  "license": "MIT",
  "author": "Chris <goabonga@pm.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goabonga/test-pipelilne-multicz.git",
    "directory": "packages/web"
  },
  "bugs": {
    "url": "https://github.com/goabonga/test-pipelilne-multicz/issues"
  },
  "homepage": "https://github.com/goabonga/test-pipelilne-multicz",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome lint src tests",
    "format": "biome format --write src tests",
    "format:check": "biome format src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@shomer/lib": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
