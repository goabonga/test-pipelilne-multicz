[Unit]
Description=Shomer authorization HTTP API
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/bin/shomer-api
Restart=on-failure
RestartSec=2s
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
