{
  "name": "@shomer/app",
  "version": "0.1.1",
  "description": "Shomer React Native app (iOS + Android). Shares validation/types with the web client through @shomer/lib.",
  "license": "MIT",
  "author": "Chris <goabonga@pm.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goabonga/test-pipelilne-multicz.git",
    "directory": "packages/app"
  },
  "bugs": {
    "url": "https://github.com/goabonga/test-pipelilne-multicz/issues"
  },
  "homepage": "https://github.com/goabonga/test-pipelilne-multicz",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@shomer/lib": "file:../lib",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@biomejs/biome": "^2.5.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "^29.6.3",
    "react-test-renderer": "19.2.8",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "fast-xml-parser": "^5.10.1",
    "js-yaml": "^4.3.1"
  }
}
