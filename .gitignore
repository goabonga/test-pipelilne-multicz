# Node (web builds JS/CSS/templates that land in packages/ssr/)
packages/web/node_modules/
packages/web/dist/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.uv/
build/
dist/
.pytest_cache/
.ruff_cache/

# Helm
*.tgz
packages/api/chart/charts/
packages/job/chart/charts/

# Debian build artefacts (generated by dpkg-buildpackage one level up)
*.deb
*.dsc
*.changes
*.buildinfo
*.tar.xz
*.tar.gz
debian/.debhelper/
debian/files
debian/*.substvars
debian/*.debhelper.log
debian/shomer-*/

# Docs build
site/

# Local compose env (real values go here; .env.example is committed)
.env

# Source maps emitted by `node scripts/build.mjs --watch` in dev. The
# one-shot release build (called by web's multicz post_bump) doesn't
# generate them, so this only catches stray dev artefacts.
packages/ssr/src/shomer_ssr/static/*.map

# Editor
.vscode/
.idea/
*.swp
.DS_Store
