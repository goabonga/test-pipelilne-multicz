# Node (web builds JS/CSS/templates that land in packages/ssr/)
# npm workspaces hoist dependencies into the repo-root node_modules.
node_modules/
packages/web/dist/
packages/lib/dist/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.uv/
build/
dist/
.pytest_cache/
.ruff_cache/

# Helm
*.tgz
packages/api/chart/charts/
packages/job/chart/charts/

# Debian build artefacts (generated by dpkg-buildpackage one level up)
*.deb
*.dsc
*.changes
*.buildinfo
*.tar.xz
*.tar.gz
debian/.debhelper/
debian/files
debian/*.substvars
debian/*.debhelper.log
debian/shomer-*/

# Docs build
site/

# Local compose env (real values go here; .env.example is committed)
.env

# Source maps emitted by `node scripts/build.mjs --watch` in dev. The
# one-shot release build (called by web's multicz post_bump) doesn't
# generate them, so this only catches stray dev artefacts.
packages/ssr/src/shomer_ssr/static/*.map

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Coverage artifacts
.coverage

# Terragrunt / Terraform working state (infrastructure/). All of it is
# regenerated by `terragrunt run` and dropped by `make infra-clean`; the
# lockfile is deliberately ignored too until a provider is wired, since
# with no required_providers there is nothing meaningful to lock.
.terragrunt-cache/
.terraform/
.terraform.lock.hcl
generated_*.tf

# Bootstrap state. These roots run with LOCAL state by design — they create
# the backend the rest of the tree uses. The file is not a secret to be
# hidden so much as a thing that must never be committed: two people with
# two copies is how a bucket ends up managed twice.
infrastructure/bootstrap/*/terraform.tfstate
infrastructure/bootstrap/*/terraform.tfstate.backup
infrastructure/bootstrap/*/.terraform/
infrastructure/bootstrap/*/.terraform.lock.hcl
